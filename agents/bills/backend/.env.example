# Copy to .env in this folder (agents/bills/backend/.env). Never commit .env.
# Plaid SANDBOX keys from https://dashboard.plaid.com (Developers > Keys).
PLAID_CLIENT_ID=your-sandbox-client-id
PLAID_SECRET=your-sandbox-secret
# Must stay "sandbox". Anything else is refused on purpose.
PLAID_ENV=sandbox
# Encrypts Plaid access tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BILLS_TOKEN_ENCRYPTION_KEY=
# Optional. Defaults to $AGENT_DATA_DIR/bills.db, or agents/bills/backend/data/bills.db
BILLS_DATABASE_URL=
