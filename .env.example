# Copy to .env and fill in. Never commit .env. Each folder may have its own .env.example too.

# Platform
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/platform.db
AGENT_DATA_DIR=./data/agents

# Remote agents (Hermes): shared secret used to sign platform -> agent requests
REMOTE_AGENT_SHARED_SECRET=change-me
